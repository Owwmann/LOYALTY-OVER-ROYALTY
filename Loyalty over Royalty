'use client';
import { products } from '@/lib/products';
import DesignTool from '@/components/DesignTool';
import { notFound } from 'next/navigation';

// Helper function to find product by ID on the client side
const getProductById = (id) => products.find(p => p.id === id);

export default function ProductPage({ params }) {
  const { id } = params;
  const product = getProductById(id);

  if (!product) {
    // In a real app with server-side fetching, you'd use the notFound() function from Next.js
    // For this client-side example, we'll just show a message.
    return <div>Product not found</div>;
  }

  return (
    <div className="container mx-auto px-4 py-8">
      <div className="grid md:grid-cols-2 gap-12">
        {/* Product Info Section */}
        <div>
          <h1 className="text-3xl font-bold">{product.name}</h1>
          <p className="text-2xl font-semibold text-yellow-400 my-2">${product.price.toFixed(2)}</p>
          <p className="text-gray-300 mt-4">High-quality {product.category.toLowerCase()} perfect for custom designs.</p>
        </div>

        {/* Design Tool Section */}
        <div>
          <DesignTool product={product} />
        </div>
      </div>
    </div>
  );
}
